# Required
MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=meu
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional
# JSON stdout in production; Compose forces NODE_ENV=production/PRETTY_LOGS=false.
# debug/trace are opt-in. Keep prompts, broker payloads and credentials out of logs.
LOG_LEVEL=info
PRETTY_LOGS=true
AGENT_CACHE_TTL_SECONDS=86400
# "db" writes directly to Mongo; "queue" emits to the notification consumer
NOTIFICATION_TRANSPORT=queue
NODE_ENV=development
NOTIFY_AGENT_SUCCESS=false

# Shared 32-byte AES key, encoded as 64 hex characters; generate with openssl rand -hex 32
ENCRYPTION_KEY=
