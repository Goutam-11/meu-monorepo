# Required
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=meu
REDIS_URL=redis://localhost:6379

# Web Push (generate with: bunx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional
# JSON stdout in production; Compose forces NODE_ENV=production/PRETTY_LOGS=false.
# Notification text, subscription URLs, keys and raw SDK errors are excluded.
LOG_LEVEL=info
PRETTY_LOGS=true
NODE_ENV=development
