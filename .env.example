# Shared Compose interpolation. Copy to .env; never commit the populated file.
# Reuse the EXISTING key from meu_frontend/.env if encrypted records exist.
ENCRYPTION_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000
# Database/auth/provider settings remain in each service's .env.
